// Prisma Schema for FACSS Corporate Platform
// Aden First Center for Security Services and Strategic Studies

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  CONTENT_MANAGER
  SERVICE_MANAGER
  TRAINING_MANAGER
  RESEARCH_MANAGER
  EMPLOYEE
  FIELD_FOCAL_POINT
  CLIENT
  TRAINEE
}

enum RequestStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  WAITING_FOR_CLIENT
  APPROVED
  IN_PROGRESS
  REPORT_READY
  COMPLETED
  CANCELLED
}

enum Priority {
  NORMAL
  HIGH
  URGENT
}

enum CourseStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLIST
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum Visibility {
  PUBLIC
  REGISTERED_USERS
  CLIENT_ONLY
  PRIVATE
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum EvaluationType {
  PRE
  POST
}

enum EvaluationStatus {
  NOT_REQUIRED
  NOT_TAKEN
  COMPLETED
}

enum MessageStatus {
  UNREAD
  READ
  IN_PROGRESS
  RESOLVED
  REPLIED
  ARCHIVED
}

model User {
  id               String                 @id @default(cuid())
  email            String                 @unique
  passwordHash     String
  fullName         String
  phone            String?
  organization     String?
  role             Role                   @default(CLIENT)
  isActive         Boolean                @default(true)
  avatar           String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  clientProfile    ClientProfile?
  serviceRequests  ServiceRequest[]       @relation("ClientRequests")
  assignedRequests ServiceRequest[]       @relation("AssignedStaff")
  registrations    TrainingRegistration[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  notes            ServiceRequestNote[]
  capabilities     UserCapability[]

  // Phase 2: Field Incidents & Alerts Relations
  createdIncidents  Incident[]             @relation("CreatedIncidents")
  assignedIncidents IncidentAssignment[]   @relation("AssignedIncidents")
  verifiedIncidents IncidentVerification[] @relation("VerifiedIncidents")
  alertRecipients   AlertRecipient[]
  alertDeliveryLogs AlertDeliveryLog[]

  // Phase 3: Operational Risks Relation
  createdRisks      OperationalRisk[]      @relation("CreatedRisks")

  // Package B: Complaints & Contact Messages Assignment
  assignedMessages  ContactMessage[]       @relation("AssignedContactMessages")

  // Package C: Quality Assurance & Client Feedback
  reviewedDocuments             ServiceRequestDocument[]       @relation("QaReviewer")
  clientFeedbacks               ClientFeedback[]               @relation("ClientFeedbackAuthor")

  // Package D: Academy, Trainers, Materials & Needs Assessment
  clientPrivateCourses          Course[]                       @relation("ClientPrivateCourses")
  uploadedTrainingMaterials     TrainingMaterial[]             @relation("UploadedTrainingMaterials")
  trainerProfile                Trainer?                       @relation("TrainerAccount")
  uploadedTrainerDocuments      TrainerDocument[]              @relation("UploadedTrainerDocuments")
  clientTnaAssessments          TrainingNeedsAssessment[]      @relation("ClientTnaAssessments")
  createdTnaAssessments         TrainingNeedsAssessment[]      @relation("CreatedTnaAssessments")
  courseSatisfactionEvaluations CourseSatisfactionEvaluation[] @relation("CourseSatisfactionAuthor")

  // Package E: Procurement, Inventory & Equipment Relations
  createdProcurements           ProcurementOrder[]             @relation("CreatedProcurements")
  approvedProcurements          ProcurementOrder[]             @relation("ApprovedProcurements")
  receivedProcurements          ProcurementReceiving[]         @relation("ReceivedProcurements")
  inspectionsConducted          EquipmentInspection[]          @relation("InspectionsConducted")
  deliveriesConducted           EquipmentDelivery[]            @relation("DeliveriesConducted")
  movementsRecorded             InventoryMovement[]            @relation("MovementsRecorded")

  @@index([role])
  @@index([email])
}

model ClientProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  companyName   String
  sector        String?
  taxNumber     String?
  address       String?
  accountStatus String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id          String    @id @default(cuid())
  titleAr     String
  titleEn     String
  slug        String    @unique
  icon        String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services    Service[]
}

model Service {
  id              String          @id @default(cuid())
  categoryId      String
  titleAr         String
  titleEn         String
  slug            String          @unique
  shortDescAr     String
  shortDescEn     String
  fullDescAr      String          @db.Text
  fullDescEn      String          @db.Text
  featuresAr      String          @db.Text // JSON string array
  featuresEn      String          @db.Text // JSON string array
  targetSectorsAr String?         @db.Text // JSON string array
  targetSectorsEn String?         @db.Text // JSON string array
  processAr       String?         @db.Text // JSON string array
  processEn       String?         @db.Text // JSON string array
  icon            String?
  image           String?
  order           Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  category        ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  requests        ServiceRequest[]

  @@index([slug])
  @@index([categoryId])
}

model ServiceRequest {
  id                 String                   @id @default(cuid())
  requestNumber      String                   @unique // e.g. FACSS-SR-2026-000101
  userId             String?
  serviceId          String
  organization       String
  contactName        String
  contactEmail       String
  contactPhone       String
  priority           Priority                 @default(NORMAL)
  status             RequestStatus            @default(NEW)
  description        String                   @db.Text
  assignedEmployeeId String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  service            Service                  @relation(fields: [serviceId], references: [id])
  user               User?                    @relation("ClientRequests", fields: [userId], references: [id], onDelete: SetNull)
  assignedEmployee   User?                    @relation("AssignedStaff", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  notes              ServiceRequestNote[]
  documents          ServiceRequestDocument[]
  feedback           ClientFeedback?

  // Package E: Equipment & Supply Fulfillment Relations
  fulfillmentStatus   SupplyFulfillmentStatus? @default(NONE)
  supplyItems         SupplyRequestItem[]
  equipmentDeliveries EquipmentDelivery[]
  equipmentReturns    EquipmentReturn[]
  procurementOrders   ProcurementOrder[]

  @@index([requestNumber])
  @@index([status])
  @@index([userId])
  @@index([fulfillmentStatus])
}

model ServiceRequestNote {
  id              String         @id @default(cuid())
  requestId       String
  authorId        String?
  authorName      String
  note            String         @db.Text
  isClientVisible Boolean        @default(false)
  createdAt       DateTime       @default(now())

  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author          User?          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ServiceRequestDocument {
  id               String         @id @default(cuid())
  requestId        String
  title            String
  filePath         String
  fileSize         Int
  fileType         String
  uploadedById     String
  isConfidential   Boolean        @default(true)
  createdAt        DateTime       @default(now())

  // Phase 2C Document Security & Operations Metadata
  documentType     String         @default("CLIENT_ATTACHMENT") // CLIENT_ATTACHMENT, INTERNAL_DOCUMENT, FINAL_REPORT
  originalFilename String?
  storageKey       String?
  mimeType         String?
  visibility       String         @default("CLIENT_VISIBLE") // CLIENT_VISIBLE, INTERNAL_ONLY
  isArchived       Boolean        @default(false)
  uploadedByUserId String?
  sizeBytes        Int?
  updatedAt        DateTime       @default(now()) @updatedAt

  // Package C: Report Quality Assurance (QA) Workflow
  // Values: NOT_APPLICABLE, PENDING_QA, UNDER_REVIEW, APPROVED, REJECTED, DELIVERED, CLIENT_ACCEPTED
  qaStatus         String         @default("NOT_APPLICABLE")
  qaReviewerId     String?
  qaReviewedAt     DateTime?
  qaNotes          String?        @db.Text
  qaApprovedAt     DateTime?
  deliveredAt      DateTime?
  clientAcceptedAt DateTime?

  request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  qaReviewer       User?          @relation("QaReviewer", fields: [qaReviewerId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([documentType])
  @@index([visibility])
  @@index([isArchived])
  @@index([uploadedByUserId])
  @@index([qaStatus])
}

model ClientFeedback {
  id             String         @id @default(cuid())
  requestId      String         @unique
  clientId       String
  overallRating  Int            // 1 to 5
  serviceQuality Int            // 1 to 5
  timeliness     Int            // 1 to 5
  communication  Int            // 1 to 5
  comment        String?        @db.Text
  submittedAt    DateTime       @default(now())

  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  client         User           @relation("ClientFeedbackAuthor", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([submittedAt])
}

model CourseCategory {
  id        String   @id @default(cuid())
  titleAr   String
  titleEn   String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]
}

model Course {
  id                   String                 @id @default(cuid())
  categoryId           String
  titleAr              String
  titleEn              String
  slug                 String                 @unique
  descriptionAr        String                 @db.Text
  descriptionEn        String                 @db.Text
  trainerName          String
  startDate            DateTime?
  endDate              DateTime?
  duration             String
  location             String
  capacity             Int                    @default(25)
  registrationDeadline DateTime?
  requirementsAr       String?                @db.Text
  requirementsEn       String?                @db.Text
  hasCertificate       Boolean                @default(true)
  status               CourseStatus           @default(OPEN)
  image                String?
  requiresPreEval      Boolean                @default(false)
  requiresPostEval     Boolean                @default(false)
  minAttendancePct     Float                  @default(75)

  // Package D: Academy Course Type, Delivery Mode, Client & Objectives
  courseType           String                 @default("PUBLIC") // PUBLIC, PRIVATE_CLIENT
  deliveryMode         String                 @default("IN_PERSON") // IN_PERSON, VIRTUAL, HYBRID, FIELD
  clientId             String?
  objectivesAr         String?                @db.Text
  objectivesEn         String?                @db.Text
  targetAudienceAr     String?                @db.Text
  targetAudienceEn     String?                @db.Text

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  category             CourseCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  client               User?                  @relation("ClientPrivateCourses", fields: [clientId], references: [id], onDelete: SetNull)
  registrations        TrainingRegistration[]
  sessions             TrainingSession[]
  materials            TrainingMaterial[]
  trainers             CourseTrainer[]
  tnaAssessments       TrainingNeedsAssessment[] @relation("CourseTnaAssessments")
  satisfactionEvaluations CourseSatisfactionEvaluation[]

  @@index([slug])
  @@index([status])
  @@index([courseType])
  @@index([clientId])
}

model TrainingRegistration {
  id                     String             @id @default(cuid())
  courseId               String
  userId                 String?
  fullName               String
  nationalId             String?
  email                  String
  phone                  String
  qualification          String?
  status                 RegistrationStatus @default(PENDING)
  adminNotes             String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  course                 Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendanceRecords      AttendanceRecord[]
  certificate            Certificate?
  evaluations            TrainingEvaluation[]
  satisfactionEvaluation CourseSatisfactionEvaluation?

  @@index([courseId])
  @@index([userId])
  @@index([status])
}

model TrainingSession {
  id            String               @id @default(cuid())
  courseId      String
  sessionNumber Int
  title         String
  sessionDate   DateTime
  startTime     String?
  endTime       String?
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  course        Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances   AttendanceRecord[]

  @@unique([courseId, sessionNumber])
  @@index([courseId])
  @@index([sessionDate])
}

model AttendanceRecord {
  id             String               @id @default(cuid())
  registrationId String
  sessionId      String?
  sessionDate    DateTime
  status         AttendanceStatus     @default(PRESENT)
  notes          String?
  modifiedById   String?
  modifiedAt     DateTime?
  modifiedReason String?
  createdAt      DateTime             @default(now())

  registration   TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  session        TrainingSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, sessionId])
  @@index([registrationId])
  @@index([sessionId])
}

model TrainingEvaluation {
  id             String               @id @default(cuid())
  registrationId String
  type           EvaluationType
  score          Float?
  maxScore       Float                @default(100)
  status         EvaluationStatus     @default(NOT_TAKEN)
  notes          String?              @db.Text
  evaluatedById  String?
  evaluatedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  registration   TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, type])
  @@index([registrationId])
}

model Certificate {
  id                String               @id @default(cuid())
  certificateNumber String               @unique // e.g. FACSS-CERT-2026-0045
  registrationId    String               @unique
  studentName       String
  courseTitle       String
  issueDate         DateTime             @default(now())
  grade             String?
  verificationCode  String               @unique
  pdfPath           String?
  createdAt         DateTime             @default(now())

  // Phase 2D: Certificate Revocation Support
  isRevoked         Boolean              @default(false)
  revokedReason     String?
  revokedAt         DateTime?

  registration      TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([certificateNumber])
  @@index([verificationCode])
}

// ==========================================
// PACKAGE D: ACADEMY, MATERIALS, TRAINERS & TNA
// ==========================================

model TrainingMaterial {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?  @db.Text
  fileKey     String
  fileName    String
  fileSize    Int
  mimeType    String
  visibility  String   @default("ENROLLED_TRAINEES") // INTERNAL, ENROLLED_TRAINEES, PUBLIC
  sortOrder   Int      @default(0)
  uploadedById String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation("UploadedTrainingMaterials", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([visibility])
  @@index([uploadedById])
}

model Trainer {
  id                  String             @id @default(cuid())
  userId              String?            @unique
  fullNameAr          String
  fullNameEn          String?
  professionalTitleAr String
  professionalTitleEn String?
  specializations     String?            @db.Text
  bioAr               String?            @db.Text
  bioEn               String?            @db.Text
  qualifications      String?            @db.Text
  certifications      String?            @db.Text
  email               String?
  phone               String?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User?              @relation("TrainerAccount", fields: [userId], references: [id], onDelete: SetNull)
  courseAssignments   CourseTrainer[]
  documents           TrainerDocument[]

  @@index([isActive])
  @@index([userId])
}

model CourseTrainer {
  id         String   @id @default(cuid())
  courseId   String
  trainerId  String
  role       String   @default("LEAD_TRAINER") // LEAD_TRAINER, ASSISTANT_TRAINER, GUEST_LECTURER
  isLead     Boolean  @default(true)
  assignedAt DateTime @default(now())

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer    Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([courseId, trainerId])
  @@index([courseId])
  @@index([trainerId])
}

model TrainerDocument {
  id                 String    @id @default(cuid())
  trainerId          String
  title              String
  documentType       String    // CV, CERTIFICATION, ACCREDITATION, DEGREE, ID_PASSPORT
  issuingBody        String?
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String    @default("VERIFIED") // PENDING, VERIFIED, EXPIRED
  fileKey            String
  fileName           String
  fileSize           Int
  mimeType           String
  uploadedById       String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  trainer            Trainer   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  uploadedBy         User      @relation("UploadedTrainerDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([documentType])
}

model TrainingNeedsAssessment {
  id                 String    @id @default(cuid())
  referenceNumber    String    @unique // e.g. FACSS-TNA-2026-0001
  title              String
  clientId           String?
  courseId           String?
  targetAudience     String
  participantCount   Int       @default(1)
  requestedTopics    String    @db.Text
  currentCompetency  String    @db.Text
  desiredCompetency  String    @db.Text
  operationalContext String?   @db.Text
  recommendations    String?   @db.Text
  assessmentDate     DateTime  @default(now())
  status             String    @default("DRAFT") // DRAFT, SUBMITTED, REVIEWED, APPROVED, IMPLEMENTED
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client             User?     @relation("ClientTnaAssessments", fields: [clientId], references: [id], onDelete: SetNull)
  course             Course?   @relation("CourseTnaAssessments", fields: [courseId], references: [id], onDelete: SetNull)
  createdBy          User      @relation("CreatedTnaAssessments", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([courseId])
  @@index([status])
}

model CourseSatisfactionEvaluation {
  id                 String               @id @default(cuid())
  registrationId     String               @unique
  courseId           String
  userId             String?
  contentRating      Int                  // 1 to 5
  trainerRating      Int                  // 1 to 5
  organizationRating Int                  // 1 to 5
  usefulnessRating   Int                  // 1 to 5
  overallRating      Int                  // 1 to 5
  comment            String?              @db.Text
  submittedAt        DateTime             @default(now())

  registration       TrainingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user               User?                @relation("CourseSatisfactionAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([submittedAt])
}

model ResearchCategory {
  id           String                @id @default(cuid())
  titleAr      String
  titleEn      String
  slug         String                @unique
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  publications ResearchPublication[]
}

model ResearchPublication {
  id              String           @id @default(cuid())
  categoryId      String
  titleAr         String
  titleEn         String
  slug            String           @unique
  author          String
  summaryAr       String           @db.Text
  summaryEn       String           @db.Text
  contentAr       String           @db.Text
  contentEn       String           @db.Text
  coverImage      String?
  pdfPath         String?
  publicationDate DateTime         @default(now())
  visibility      Visibility            @default(PUBLIC)
  status          ArticleStatus         @default(PUBLISHED)
  isFeatured      Boolean               @default(false)
  viewsCount      Int                   @default(0)
  submittedById   String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?               @db.Text
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  category        ResearchCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accessGrants    ResearchAccessGrant[]
  reviewLogs      ResearchReviewLog[]

  @@index([slug])
  @@index([visibility])
  @@index([status])
  @@index([categoryId])
}

model ResearchAccessGrant {
  id              String              @id @default(cuid())
  publicationId   String
  grantedToUserId String
  grantedByUserId String
  isActive        Boolean             @default(true)
  revokedAt       DateTime?
  revokedByUserId String?
  revokedReason   String?
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  publication     ResearchPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, grantedToUserId])
  @@index([publicationId])
  @@index([grantedToUserId])
}

model ResearchReviewLog {
  id             String              @id @default(cuid())
  publicationId  String
  action         String
  fromStatus     String
  toStatus       String
  reviewerUserId String
  reviewerName   String
  comments       String?             @db.Text
  createdAt      DateTime            @default(now())

  publication    ResearchPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
  @@index([createdAt])
}

model NewsArticle {
  id          String        @id @default(cuid())
  titleAr     String
  titleEn     String
  slug        String        @unique
  summaryAr   String        @db.Text
  summaryEn   String        @db.Text
  contentAr   String        @db.Text
  contentEn   String        @db.Text
  coverImage  String?
  author      String
  category    String?
  status      ArticleStatus @default(PUBLISHED)
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

model ContactMessage {
  id                String        @id @default(cuid())
  messageType       String        @default("GENERAL_INQUIRY") // GENERAL_INQUIRY | COMPLAINT
  referenceNumber   String?       @unique // e.g. FACSS-CMP-2026-000001
  name              String
  email             String
  phone             String?
  organization      String?
  subject           String
  message           String        @db.Text
  status            MessageStatus @default(UNREAD)
  priority          Priority      @default(NORMAL)
  assignedToUserId  String?
  dueAt             DateTime?
  resolvedAt        DateTime?
  resolutionSummary String?       @db.Text
  slaStatus         String?       // ON_TIME | BREACHED | RESOLVED_ON_TIME | RESOLVED_BREACHED
  replyNotes        String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  assignedTo        User?         @relation("AssignedContactMessages", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([messageType])
  @@index([referenceNumber])
  @@index([assignedToUserId])
  @@index([dueAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  titleAr   String
  titleEn   String
  messageAr String
  messageEn String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("GENERAL") // GENERAL, CONTACT, SOCIAL, SEO, BRANDING
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}

// Content Management System — Institutional Content Blocks
// Sections: identity | principles | activity_fields | lifecycle | org_structure | beneficiaries | homepage | footer
model ContentBlock {
  id            String   @id @default(cuid())
  section       String   // e.g. 'identity', 'principles', 'activity_fields', 'lifecycle', 'org_structure', 'beneficiaries', 'homepage'
  key           String   // unique key within section, e.g. 'vision', 'mission', 'principle_1'
  titleAr       String?  @db.Text
  titleEn       String?  @db.Text
  descriptionAr String?  @db.Text
  descriptionEn String?  @db.Text
  icon          String?  // lucide icon name
  link          String?  // optional URL / route
  order         Int      @default(0)
  isVisible     Boolean  @default(true)
  metadata      String?  @db.Text  // JSON for extra fields
  updatedByName String?  // name of admin who last edited
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
  @@index([section, isVisible])
  @@index([order])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model UserCapability {
  id         String   @id @default(cuid())
  userId     String
  capability String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([userId])
  @@index([capability])
}

// ==========================================
// PHASE 2: FIELD INCIDENTS, VERIFICATION & ALERTS
// ==========================================

enum IncidentStatus {
  RECEIVED
  TRIAGED
  REDACTED
  ASSIGNED
  UNDER_VERIFICATION
  VERIFIED
  UNCONFIRMED
  CONTRADICTED
  DISPROVED
  DUPLICATE
  ALERT_DRAFTED
  ALERT_APPROVED
  ALERT_DISPATCHED
  RESOLVED
  CLOSED
  ARCHIVED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL_EMERGENCY
}

enum IncidentCategory {
  // Existing Historical Categories
  ARMED_CONFLICT_TACTICAL
  HUMANITARIAN_ACCESS_DENIAL
  PHYSICAL_ATTACK_THREAT
  UXO_LANDMINE_HAZARD
  CIVIL_UNREST_ROADBLOCK
  DETENTION_HARASSMENT
  NATURAL_DISASTER_ENVIRONMENTAL
  // Package B: Security & Safety Operational Categories
  THEFT
  INTRUSION
  FIRE
  INJURY
  SAFETY_INCIDENT
  VEHICLE_INCIDENT
  SECURITY_THREAT
}

enum AlertSeverity {
  INFORMATIONAL
  ADVISORY_WATCH
  WARNING_HIGH
  CRITICAL_FLASH
}

enum AlertTier {
  REDACTED_OPERATIONAL_BRIEFING
  EXECUTIVE_FLASH_SUMMARY
}

enum AlertApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AttachmentSensitivity {
  ORIGINAL_SENSITIVE
  REDACTED_SAFE
}

model Incident {
  id               String            @id @default(cuid())
  incidentNumber   String            @unique // e.g. FACSS-INC-2026-000101
  category         IncidentCategory
  priority         IncidentPriority  @default(MEDIUM)
  status           IncidentStatus    @default(RECEIVED)
  governorate      String
  district         String?
  incidentDate     DateTime
  parentIncidentId String?
  createdById      String

  // Package B: Operations, 24/7 Monitoring & Configurable SLA Timestamps
  firstResponseAt  DateTime?
  dueAt            DateTime?
  closedAt         DateTime?
  slaTargetMinutes Int?
  slaStatus        String?           // ON_TIME | APPROACHING_BREACH | BREACHED | CLOSED_ON_TIME | CLOSED_BREACHED
  isEscalated      Boolean           @default(false)
  escalatedAt      DateTime?
  escalationReason String?           @db.Text

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  original         IncidentOriginal?
  redactedVersions IncidentRedacted[]
  assignments      IncidentAssignment[]
  verifications    IncidentVerification[]
  alerts           IncidentAlert[]
  attachments      IncidentAttachment[]
  risks            OperationalRisk[]

  parentIncident   Incident?         @relation("IncidentDuplicates", fields: [parentIncidentId], references: [id], onDelete: SetNull)
  duplicateReports Incident[]        @relation("IncidentDuplicates")
  createdBy        User              @relation("CreatedIncidents", fields: [createdById], references: [id])

  @@index([incidentNumber])
  @@index([status])
  @@index([category])
  @@index([governorate])
  @@index([incidentDate])
  @@index([createdById])
  @@index([dueAt])
  @@index([isEscalated])
}

model IncidentOriginal {
  id                  String    @id @default(cuid())
  incidentId          String    @unique
  sourceType          String    // FOCAL_POINT, EYEWITNESS, FIELD_STAFF
  sourceNameEnc       String    @db.Text
  sourcePhoneEnc      String?   @db.Text
  sourceOrgEnc        String?   @db.Text
  rawDescriptionEnc   String    @db.Text
  exactLocationEnc    String?   @db.Text
  exactLatEnc         String?   @db.Text
  exactLngEnc         String?   @db.Text
  initialRiskNotesEnc String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  incident            Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model IncidentRedacted {
  id               String    @id @default(cuid())
  incidentId       String
  versionNumber    Int       @default(1)
  redactedTitleAr  String
  redactedTitleEn  String?
  redactedDescAr   String    @db.Text
  redactedDescEn   String?   @db.Text
  safeAreaScopeAr  String
  safeAreaScopeEn  String?
  immediateImpact  String?   @db.Text
  safetyAdvisory   String?   @db.Text
  approvedByUserId String
  isApproved       Boolean   @default(true)
  isCurrent        Boolean   @default(true)
  createdAt        DateTime  @default(now())

  incident         Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, isCurrent])
}

model IncidentAssignment {
  id               String    @id @default(cuid())
  incidentId       String
  assignedToUserId String
  assignedByUserId String
  roleScope        String    // VERIFIER, ANALYST
  instructions     String?   @db.Text
  isActive         Boolean   @default(true)
  assignedAt       DateTime  @default(now())
  revokedAt        DateTime?

  incident         Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  assignedTo       User      @relation("AssignedIncidents", fields: [assignedToUserId], references: [id], onDelete: Cascade)

  @@index([incidentId, isActive])
  @@index([assignedToUserId, isActive])
}

model IncidentVerification {
  id                  String    @id @default(cuid())
  incidentId          String
  verifiedByUserId    String
  sourceReliability   String    // Admiralty: A, B, C, D, E, F
  infoCredibility     String    // Admiralty: 1, 2, 3, 4, 5, 6
  admiraltyCode       String    // Combined code e.g. "A1", "B2", "C3"
  verificationMethod  String
  verificationSummary String    @db.Text
  corroboratingCount  Int       @default(1)
  contradictionsFound Boolean   @default(false)
  contradictionNotes  String?   @db.Text
  verifiedAt          DateTime  @default(now())

  incident            Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  verifiedBy          User      @relation("VerifiedIncidents", fields: [verifiedByUserId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([admiraltyCode])
}

model IncidentAlert {
  id                  String              @id @default(cuid())
  alertNumber         String              @unique // e.g. FACSS-ALT-2026-000101
  incidentId          String
  severity            AlertSeverity
  titleAr             String              // Tier 1: Redacted Operational Briefing Title
  titleEn             String?
  bodyAr              String              @db.Text // Tier 1: Redacted Operational Briefing Body
  bodyEn              String?             @db.Text
  executiveTitleAr    String?             // Tier 2: Executive Flash Summary Title
  executiveSummaryAr  String?             @db.Text // Tier 2: Executive Flash Summary Body
  movementAdviceAr    String?             @db.Text // Reviewed & Sanitized Movement Advice
  movementAdviceEn    String?             @db.Text
  targetGovernorate   String
  targetDistricts     String              // JSON array string of districts
  approvalStatus      AlertApprovalStatus @default(DRAFT)
  currentVersion      Int                 @default(1)
  activeSnapshotId    String?
  draftedByUserId     String?
  approvedByUserId    String?
  approvedAt          DateTime?
  dispatchedAt        DateTime?
  expiresAt           DateTime?
  isPrecautionary     Boolean             @default(false)
  isCorrection        Boolean             @default(false)
  replacesAlertId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  incident            Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  snapshots           AlertSnapshot[]
  recipients          AlertRecipient[]
  deliveryLogs        AlertDeliveryLog[]

  @@index([alertNumber])
  @@index([approvalStatus])
  @@index([severity])
}

model AlertSnapshot {
  id                 String              @id @default(cuid())
  alertId            String
  approvalVersion    Int
  titleAr            String              // Frozen Tier 1 Title
  titleEn            String?
  bodyAr             String              @db.Text // Frozen Tier 1 Body
  bodyEn             String?             @db.Text
  executiveTitleAr   String?             // Frozen Tier 2 Title
  executiveSummaryAr String?             @db.Text // Frozen Tier 2 Body
  movementAdviceAr   String?             @db.Text
  movementAdviceEn   String?             @db.Text
  severity           AlertSeverity
  targetGovernorate  String
  targetDistricts    String
  isPrecautionary    Boolean             @default(false)
  approvedByUserId   String
  approvedAt         DateTime            @default(now())
  snapshotHash       String
  frozenRecipients   String              @db.Text // Serialized array of recipients & tiers

  alert              IncidentAlert       @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, approvalVersion])
  @@index([alertId])
  @@index([snapshotHash])
}

model AlertRecipient {
  id               String        @id @default(cuid())
  alertId          String
  recipientUserId  String
  alertTier        AlertTier
  isDispatched     Boolean       @default(false)
  dispatchedAt     DateTime?
  readAt           DateTime?

  alert            IncidentAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipientUser    User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([alertId, recipientUserId])
  @@index([alertId])
  @@index([recipientUserId])
}

model AlertDeliveryLog {
  id               String        @id @default(cuid())
  alertId          String
  recipientUserId  String
  channel          String        @default("IN_APP_PORTAL")
  status           String        // SUCCESS, FAILED
  idempotencyKey   String        @unique
  errorMessage     String?
  deliveredAt      DateTime?
  readAt           DateTime?
  createdAt        DateTime      @default(now())

  alert            IncidentAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  recipientUser    User          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([status])
  @@index([idempotencyKey])
}

model IncidentAttachment {
  id                 String                @id @default(cuid())
  incidentId         String
  fileName           String
  fileSize           Int
  mimeType           String
  storageKey         String
  sensitivity        AttachmentSensitivity @default(ORIGINAL_SENSITIVE)
  hasExifStripped    Boolean               @default(false)
  uploadedByUserId   String
  uploadedAt         DateTime              @default(now())

  incident           Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([sensitivity])
}

// ==========================================
// PHASE 3: OPERATIONAL RISK REGISTER
// ==========================================

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  TREATMENT_IN_PROGRESS
  MONITORED
  RESOLVED
  CLOSED
}

enum RiskCategory {
  ARMED_CONFLICT_SECURITY
  ACCESS_ROADBLOCK_DENIAL
  EXPLOSIVE_HAZARD_UXO
  CRIMINALITY_THEFT
  STAFF_DETENTION_THREAT
  FACILITY_DAMAGE
  ENVIRONMENTAL_NATURAL
  HEALTH_SAFETY
}

enum MitigationStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum MitigationType {
  PREVENTIVE
  CONTINGENCY
  CORRECTIVE
}

model OperationalRisk {
  id                   String                  @id @default(cuid())
  riskNumber           String                  @unique // e.g. AICSFA-RSK-2026-000101
  title                String
  description          String                  @db.Text
  category             RiskCategory
  status               RiskStatus              @default(IDENTIFIED)
  governorate          String
  district             String?
  generalLocation      String?
  incidentId           String?
  likelihood           Int                     @default(1) // 1 to 5
  impact               Int                     @default(1) // 1 to 5
  riskScore            Int                     @default(1) // likelihood * impact (1 to 25)
  riskLevel            RiskLevel               @default(LOW)
  targetResolutionDate DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  reopenedAt           DateTime?
  reopenReason         String?                 @db.Text
  closeReason          String?                 @db.Text
  createdById          String
  lastAssessedById     String?
  lastAssessedAt       DateTime                @default(now())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  incident             Incident?               @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdBy            User                    @relation("CreatedRisks", fields: [createdById], references: [id])
  mitigations          RiskMitigationAction[]
  assessments          RiskAssessmentHistory[]

  @@index([riskNumber])
  @@index([status])
  @@index([category])
  @@index([riskLevel])
  @@index([governorate])
  @@index([incidentId])
  @@index([createdById])
}

model RiskMitigationAction {
  id            String           @id @default(cuid())
  riskId        String
  actionTitle   String
  actionType    MitigationType   @default(PREVENTIVE)
  description   String?          @db.Text
  assignedTo    String?
  dueDate       DateTime?
  status        MitigationStatus @default(PLANNED)
  progressNotes String?          @db.Text
  completedAt   DateTime?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  risk          OperationalRisk  @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@index([status])
}

model RiskAssessmentHistory {
  id             String          @id @default(cuid())
  riskId         String
  likelihood     Int
  impact         Int
  riskScore      Int
  riskLevel      RiskLevel
  rationale      String?         @db.Text
  assessedById   String
  assessedByName String
  assessedAt     DateTime        @default(now())

  risk           OperationalRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@index([assessedAt])
}

// ==========================================
// PACKAGE E: PROCUREMENT, INVENTORY & SAFETY EQUIPMENT
// ==========================================

enum ProcurementStatus {
  DRAFT
  REQUESTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum MovementType {
  RECEIPT
  RESERVATION
  RESERVATION_RELEASE
  ISSUE_DELIVERY
  RETURN
  ADJUSTMENT
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  DELIVERED
  QUARANTINE
  MAINTENANCE
  SCRAPPED
}

enum InspectionType {
  RECEIVING
  PRE_DELIVERY
  PERIODIC
  MAINTENANCE
  RETURN
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  CALIBRATION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  PREPARED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ReturnStatus {
  RETURNED
  QUARANTINE
  INSPECTED
  RESTOCKED
  SCRAPPED
}

enum SupplyFulfillmentStatus {
  NONE
  REQUESTED
  REVIEWED
  APPROVED
  STOCK_CHECKED
  RESERVED
  PROCUREMENT_REQUIRED
  INSPECTED
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
}

model EquipmentCategory {
  id          String             @id @default(cuid())
  code        String             @unique // e.g. CAT-PPE, CAT-FIRE
  nameAr      String
  nameEn      String
  description String?            @db.Text
  icon        String?
  isActive    Boolean            @default(true)
  order       Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  products    EquipmentProduct[]

  @@index([code])
  @@index([isActive])
}

model EquipmentProduct {
  id                     String                 @id @default(cuid())
  sku                    String                 @unique // Internal code / SKU e.g. FACSS-PRD-001
  nameAr                 String
  nameEn                 String
  categoryId             String
  descriptionAr          String?                @db.Text
  descriptionEn          String?                @db.Text
  unit                   String                 @default("piece") // piece, kit, set, meter, etc.
  manufacturer           String?
  brand                  String?
  model                  String?
  specifications         String?                @db.Text
  imageUrl               String?
  isActive               Boolean                @default(true)

  // Tracking rules & controls
  inspectionRequired     Boolean                @default(false)
  maintenanceRequired    Boolean                @default(false)
  expiryTrackingRequired Boolean                @default(false)
  serialTrackingRequired Boolean                @default(false)
  minimumStockLevel      Int                    @default(5)

  // Aggregate stock counts (strictly transaction-managed and verified by ledger)
  quantityOnHand         Int                    @default(0)
  quantityReserved       Int                    @default(0)

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  category               EquipmentCategory      @relation(fields: [categoryId], references: [id])
  trackedItems           TrackedEquipmentItem[]
  movements              InventoryMovement[]
  procurementItems       ProcurementItem[]
  receivingItems         ReceivingItem[]
  inspections            EquipmentInspection[]
  maintenances           EquipmentMaintenance[]
  supplyRequestItems     SupplyRequestItem[]
  deliveryItems          DeliveryItem[]
  returnItems            EquipmentReturn[]

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
}

model TrackedEquipmentItem {
  id                String                 @id @default(cuid())
  productId         String
  serialNumber      String?
  batchNumber       String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  status            ItemStatus             @default(AVAILABLE)
  location          String?
  notes             String?                @db.Text
  receivingItemId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  product           EquipmentProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  receivingItem     ReceivingItem?         @relation(fields: [receivingItemId], references: [id], onDelete: SetNull)
  deliveryItems     DeliveryItem[]
  inspections       EquipmentInspection[]
  maintenances      EquipmentMaintenance[]
  movements         InventoryMovement[]
  returns           EquipmentReturn[]

  @@unique([productId, serialNumber])
  @@index([productId])
  @@index([serialNumber])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
}

model Supplier {
  id            String             @id @default(cuid())
  supplierCode  String             @unique // e.g. FACSS-SUP-2026-0001
  name          String
  nameAr        String?
  contactPerson String?
  phone         String
  email         String?
  address       String?            @db.Text
  categories    String?            // JSON string array of supplied categories
  taxNumber     String?
  commercialReg String?
  status        String             @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLISTED
  rating        Float?             @default(5.0)
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  procurements  ProcurementOrder[]

  @@index([supplierCode])
  @@index([status])
}

model ProcurementOrder {
  id                   String                 @id @default(cuid())
  referenceNumber      String                 @unique // e.g. FACSS-PO-2026-000101
  supplierId           String
  serviceRequestId     String?
  status               ProcurementStatus      @default(DRAFT)
  orderDate            DateTime               @default(now())
  expectedDeliveryDate DateTime?
  notes                String?                @db.Text
  totalEstimatedCost   Float?
  currency             String                 @default("YER")
  createdById          String
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  supplier             Supplier               @relation(fields: [supplierId], references: [id])
  serviceRequest       ServiceRequest?        @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  createdBy            User                   @relation("CreatedProcurements", fields: [createdById], references: [id])
  approvedBy           User?                  @relation("ApprovedProcurements", fields: [approvedById], references: [id], onDelete: SetNull)
  items                ProcurementItem[]
  receivings           ProcurementReceiving[]

  @@index([referenceNumber])
  @@index([supplierId])
  @@index([serviceRequestId])
  @@index([status])
  @@index([orderDate])
}

model ProcurementItem {
  id                 String           @id @default(cuid())
  procurementOrderId String
  productId          String
  quantityOrdered    Int
  quantityReceived   Int              @default(0)
  unitPrice          Float?
  specifications     String?          @db.Text
  notes              String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  procurementOrder   ProcurementOrder @relation(fields: [procurementOrderId], references: [id], onDelete: Cascade)
  product            EquipmentProduct @relation(fields: [productId], references: [id])

  @@index([procurementOrderId])
  @@index([productId])
}

model ProcurementReceiving {
  id                 String          @id @default(cuid())
  receivingNumber    String          @unique // e.g. FACSS-RCV-2026-000101
  procurementOrderId String
  receivingDate      DateTime        @default(now())
  receivedById       String
  deliveryNoteNumber String?
  notes              String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  procurementOrder   ProcurementOrder @relation(fields: [procurementOrderId], references: [id])
  receivedBy         User            @relation("ReceivedProcurements", fields: [receivedById], references: [id])
  items              ReceivingItem[]

  @@index([receivingNumber])
  @@index([procurementOrderId])
  @@index([receivingDate])
}

model ReceivingItem {
  id                     String                 @id @default(cuid())
  procurementReceivingId String
  productId              String
  quantityReceived       Int
  quantityAccepted       Int                    // ONLY accepted quantity increases on-hand stock
  quantityRejected       Int                    @default(0)
  rejectionReason        String?                @db.Text
  batchNumber            String?
  expiryDate             DateTime?
  notes                  String?                @db.Text
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  procurementReceiving   ProcurementReceiving   @relation(fields: [procurementReceivingId], references: [id], onDelete: Cascade)
  product                EquipmentProduct       @relation(fields: [productId], references: [id])
  trackedItems           TrackedEquipmentItem[]

  @@index([procurementReceivingId])
  @@index([productId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  movementNumber String                @unique // e.g. FACSS-MOV-2026-000101
  productId      String
  trackedItemId  String?
  movementType   MovementType
  quantityBefore Int
  quantityDelta  Int                   // Positive for inward, negative for outward
  quantityAfter  Int
  referenceType  String?               // PROCUREMENT, RECEIVING, SERVICE_REQUEST, DELIVERY, RETURN, MANUAL_ADJUSTMENT
  referenceId    String?
  reason         String                @db.Text
  actorId        String
  actorName      String
  timestamp      DateTime              @default(now())

  product        EquipmentProduct      @relation(fields: [productId], references: [id])
  trackedItem    TrackedEquipmentItem? @relation(fields: [trackedItemId], references: [id], onDelete: SetNull)
  actor          User                  @relation("MovementsRecorded", fields: [actorId], references: [id])

  @@index([movementNumber])
  @@index([productId])
  @@index([trackedItemId])
  @@index([movementType])
  @@index([timestamp])
  @@index([actorId])
}

model EquipmentInspection {
  id                 String                @id @default(cuid())
  inspectionNumber   String                @unique // e.g. FACSS-INSP-2026-000101
  productId          String
  trackedItemId      String?
  inspectionType     InspectionType
  inspectionDate     DateTime              @default(now())
  inspectorId        String
  result             InspectionResult
  checklistSummary   String?               @db.Text
  findings           String?               @db.Text
  correctiveActions  String?               @db.Text
  nextInspectionDate DateTime?
  documentUrl        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  product            EquipmentProduct      @relation(fields: [productId], references: [id])
  trackedItem        TrackedEquipmentItem? @relation(fields: [trackedItemId], references: [id], onDelete: SetNull)
  inspector          User                  @relation("InspectionsConducted", fields: [inspectorId], references: [id])

  @@index([inspectionNumber])
  @@index([productId])
  @@index([trackedItemId])
  @@index([inspectionType])
  @@index([result])
  @@index([inspectionDate])
  @@index([nextInspectionDate])
}

model EquipmentMaintenance {
  id              String                @id @default(cuid())
  productId       String
  trackedItemId   String?
  maintenanceType MaintenanceType       @default(PREVENTIVE)
  status          MaintenanceStatus     @default(COMPLETED)
  maintenanceDate DateTime              @default(now())
  performedBy     String
  result          String?               @db.Text
  notes           String?               @db.Text
  nextDueDate     DateTime?
  cost            Float?
  documentUrl     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  product         EquipmentProduct      @relation(fields: [productId], references: [id])
  trackedItem     TrackedEquipmentItem? @relation(fields: [trackedItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([trackedItemId])
  @@index([maintenanceDate])
  @@index([nextDueDate])
}

model SupplyRequestItem {
  id                String           @id @default(cuid())
  serviceRequestId  String
  productId         String
  quantityRequested Int
  quantityReserved  Int              @default(0)
  quantityDelivered Int              @default(0)
  specifications    String?          @db.Text
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  serviceRequest    ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  product           EquipmentProduct @relation(fields: [productId], references: [id])

  @@index([serviceRequestId])
  @@index([productId])
}

model EquipmentDelivery {
  id                   String              @id @default(cuid())
  deliveryNumber       String              @unique // e.g. FACSS-DEL-2026-000101
  serviceRequestId     String
  status               DeliveryStatus      @default(DELIVERED)
  deliveryDate         DateTime            @default(now())
  deliveredById        String
  receivedByName       String
  receivedByPhone      String?
  receivedByRole       String?
  deliveryLocation     String?             @db.Text
  notes                String?             @db.Text
  handoverDocGenerated Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  serviceRequest       ServiceRequest      @relation(fields: [serviceRequestId], references: [id])
  deliveredBy          User                @relation("DeliveriesConducted", fields: [deliveredById], references: [id])
  items                DeliveryItem[]

  @@index([deliveryNumber])
  @@index([serviceRequestId])
  @@index([deliveryDate])
  @@index([status])
}

model DeliveryItem {
  id                  String                @id @default(cuid())
  equipmentDeliveryId String
  productId           String
  quantity            Int
  trackedItemId       String?
  notes               String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  equipmentDelivery   EquipmentDelivery     @relation(fields: [equipmentDeliveryId], references: [id], onDelete: Cascade)
  product             EquipmentProduct      @relation(fields: [productId], references: [id])
  trackedItem         TrackedEquipmentItem? @relation(fields: [trackedItemId], references: [id], onDelete: SetNull)

  @@index([equipmentDeliveryId])
  @@index([productId])
  @@index([trackedItemId])
}

model EquipmentReturn {
  id               String                @id @default(cuid())
  returnNumber     String                @unique // e.g. FACSS-RET-2026-000101
  serviceRequestId String?
  productId        String
  trackedItemId    String?
  quantity         Int
  returnDate       DateTime              @default(now())
  reason           String                @db.Text
  receivedByName   String
  status           ReturnStatus          @default(QUARANTINE)
  inspectionId     String?
  notes            String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  serviceRequest   ServiceRequest?       @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  product          EquipmentProduct      @relation(fields: [productId], references: [id])
  trackedItem      TrackedEquipmentItem? @relation(fields: [trackedItemId], references: [id], onDelete: SetNull)

  @@index([returnNumber])
  @@index([serviceRequestId])
  @@index([productId])
  @@index([trackedItemId])
  @@index([status])
  @@index([returnDate])
}


