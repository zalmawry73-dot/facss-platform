# ==============================================================================
# FACSS Corporate Platform — Environment Configuration Template
# Aden First Center for Security Services and Strategic Studies
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/facss_db?schema=public"

# Application Base URL
APP_URL="http://localhost:3000"

# JWT Authentication Secret (Generate a strong 32+ character key for production)
AUTH_SECRET="facss-super-secret-jwt-key-change-in-production-min-32-chars-xyz"

# Storage Driver (local | s3)
STORAGE_DRIVER="local"
STORAGE_PATH="./storage"

# --- Optional External Integrations (Configure when moving to Production) ---

# SMTP Email Delivery (e.g., SendGrid, Mailgun, Amazon SES, or custom SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM_ADDRESS="info@facss-aden.com"
EMAIL_FROM_NAME="FACSS Aden Center"

# SMS Gateway (e.g., Twilio, Unifonic, local Yemeni SMS provider)
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID="FACSS"

# WhatsApp Business API
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloud Storage (AWS S3 / Cloudflare R2 / MinIO)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Production Domain & SSL
NEXT_PUBLIC_APP_URL="https://www.facss-aden.com"
