# ==============================================================================
# FACSS Corporate Platform — Environment Configuration Template
# Aden First Center for Security Services and Strategic Studies
# ==============================================================================

# Database Connection (PostgreSQL / Neon)
# In production on Vercel:
# - DATABASE_URL: Pooled connection string (with -pooler) for serverless queries
# - DIRECT_URL: Direct connection string for Prisma migrations & schema push
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-PROJECT-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-PROJECT.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Application Base URL
APP_URL="https://facss-platform.vercel.app"
NEXT_PUBLIC_APP_URL="https://facss-platform.vercel.app"

# JWT Authentication Secret (Generate a strong 32+ character key for production)
AUTH_SECRET="your-secure-random-32-character-auth-secret-here"

# Storage Driver: "local" (for development) or "s3" (for Cloudflare R2 / AWS S3 in production)
STORAGE_DRIVER="s3"
STORAGE_PATH="./storage"

# --- Cloudflare R2 / AWS S3 Storage Configuration ---
# Cloudflare R2 Endpoint: https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: leave AWS_ENDPOINT blank and specify AWS_REGION (e.g. eu-central-1)
# For Cloudflare R2: set AWS_REGION="auto"
AWS_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="your-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
AWS_S3_BUCKET="facss-private-documents"

# --- Optional External Notification Integrations ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM_ADDRESS="info@facss-aden.com"
EMAIL_FROM_NAME="FACSS Aden Center"

SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID="FACSS"

WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
